generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma-clients/company-map"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Industry {
  id              String            @id @default(uuid())
  name            String
  parentId        String?           @map("parent_id")
  parent          Industry?         @relation("IndustryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Industry[]        @relation("IndustryTree")
  description     String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  companyMappings CompanyIndustry[]

  @@index([parentId])
  @@index([name])
  @@map("industries")
}

model Company {
  id               String            @id @default(uuid())
  name             String
  ticker           String?           @unique
  market           String?
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  industryMappings CompanyIndustry[]

  @@index([name])
  @@map("companies")
}

model CompanyIndustry {
  companyId  String   @map("company_id")
  industryId String   @map("industry_id")
  createdAt  DateTime @default(now()) @map("created_at")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([companyId, industryId])
  @@index([industryId])
  @@map("company_industries")
}

model StockMaster {
  code                String   @id
  name                String
  market              String?
  marcap              BigInt?
  corpCode            String?  @map("corp_code")
  // 자사주 소각 결정 공시 누적 횟수. 상세화면 "공시 갱신" 시 fetchDisclosuresForStock가 갱신.
  treasuryCancelCount Int      @default(0) @map("treasury_cancel_count")
  updatedAt           DateTime @updatedAt @map("updated_at")

  analysis          StockAnalysis?
  ncavResult        NcavResult?
  vipHoldings       VipHolding[]
  financialSnapshot FinancialSnapshot?
  opIncomeHistory   OperatingIncomeHistory[]
  tags              StockTag[]
  priceChange       PriceChange?
  memo              StockMemo?
  override          StockOverride?
  disclosures       Disclosure[]
  links             StockLink[]
  rating            StockRating?
  week52Price       Week52Price?

  @@index([name])
  @@index([market])
  @@index([marcap])
  @@map("stock_masters")
}

model StockAnalysis {
  code           String   @id
  name           String
  currentPrice   Float?   @map("current_price")
  intrinsicValue Float?   @map("intrinsic_value")
  safetyMargin   Float?   @map("safety_margin")
  treasuryRatio  Float?   @map("treasury_ratio")
  dividendYield  Float?   @map("dividend_yield")
  per            Float?   @map("per")
  pbr            Float?   @map("pbr")
  lastUpdated    DateTime @map("last_updated")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@index([safetyMargin])
  @@index([dividendYield])
  @@index([per])
  @@index([pbr])
  @@index([lastUpdated])
  @@map("stock_analyses")
}

model NcavResult {
  code             String   @id
  name             String
  ncav             BigInt
  marcap           BigInt
  ncavRatio        Float?   @map("ncav_ratio")
  currentAssets    BigInt   @map("current_assets")
  totalLiabilities BigInt   @map("total_liabilities")
  totalAssets      BigInt   @map("total_assets")
  totalEquity      BigInt   @map("total_equity")
  bsnsYear         Int      @map("bsns_year")
  ncavPositive     Boolean  @map("ncav_positive")
  lastUpdated      DateTime @map("last_updated")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@index([ncavRatio])
  @@index([ncavPositive])
  @@map("ncav_results")
}

model TradeStat {
  id          Int      @id @default(autoincrement())
  category    String   @default("semiconductor")
  yearMonth   String   @map("year_month")
  hsCode      String   @map("hs_code")
  hsCodeName  String?  @map("hs_code_name")
  countryCd   String   @map("country_cd")
  countryName String   @map("country_name")
  expDlr      BigInt   @map("exp_dlr")
  impDlr      BigInt   @map("imp_dlr")
  expWgt      BigInt   @map("exp_wgt")
  impWgt      BigInt   @map("imp_wgt")
  balPayments BigInt   @map("bal_payments")
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  @@unique([category, yearMonth, hsCode, countryCd], name: "uniq_cat_ym_hs_cnty")
  @@index([category, yearMonth])
  @@index([category, hsCode])
  @@map("trade_stats")
}

model VipHolding {
  rcpNo            String   @id @map("rcp_no")
  code             String?
  corpCode         String   @map("corp_code")
  corpName         String   @map("corp_name")
  reportNm         String   @map("report_nm")
  reportType       String   @map("report_type")
  flrNm            String   @map("flr_nm")
  rceptDt          DateTime @map("rcept_dt")
  stockRatio       Float?   @map("stock_ratio")
  stockRatioChange Float?   @map("stock_ratio_change")
  reportResn       String?  @map("report_resn")
  fetchedAt        DateTime @default(now()) @map("fetched_at")

  master StockMaster? @relation(fields: [code], references: [code], onDelete: SetNull)

  @@index([code])
  @@index([rceptDt])
  @@map("vip_holdings")
}

model FinancialSnapshot {
  code               String   @id
  latestBsnsYear     Int      @map("latest_bsns_year")
  latestReprtCode    String   @map("latest_reprt_code")
  opIncome           BigInt?  @map("op_income")
  opIncomeYoyBase    BigInt?  @map("op_income_yoy_base")
  opIncomePrevReport BigInt?  @map("op_income_prev_report")
  opIncomeYoyPct     Float?   @map("op_income_yoy_pct")
  netIncome          BigInt?  @map("net_income")
  netIncomeYoyBase   BigInt?  @map("net_income_yoy_base")
  netIncomeYoyPct    Float?   @map("net_income_yoy_pct")
  fetchedAt          DateTime @default(now()) @map("fetched_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@map("financial_snapshots")
}

model OperatingIncomeHistory {
  code      String
  bsnsYear  Int      @map("bsns_year")
  reprtCode String   @map("reprt_code")
  thstrm    BigInt?  @map("thstrm")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@id([code, bsnsYear, reprtCode])
  @@index([code, bsnsYear])
  @@map("operating_income_history")
}

model RefreshState {
  kind       String    @id
  status     String
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")
  output     String?

  @@map("refresh_states")
}

model CoveredCallSnapshot {
  id        String   @id
  payload   String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("covered_call_snapshots")
}

model Tag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  stocks    StockTag[]

  @@map("tags")
}

model StockTag {
  stockCode String   @map("stock_code")
  tagId     Int      @map("tag_id")
  createdAt DateTime @default(now()) @map("created_at")

  master StockMaster @relation(fields: [stockCode], references: [code], onDelete: Cascade)
  tag    Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([stockCode, tagId])
  @@index([tagId])
  @@map("stock_tags")
}

model PriceChange {
  code         String    @id
  currentPrice Float?    @map("current_price")
  pastPrice    Float?    @map("past_price")
  pastDate     DateTime? @map("past_date")
  pctChange    Float?    @map("pct_change")
  marcap       BigInt?   @map("marcap")
  fetchedAt    DateTime  @default(now()) @map("fetched_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@map("price_changes")
}

model StockMemo {
  code      String   @id
  text      String
  updatedAt DateTime @updatedAt @map("updated_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@map("stock_memos")
}

model StockOverride {
  code      String   @id
  manualRoe Float?   @map("manual_roe")
  updatedAt DateTime @updatedAt @map("updated_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@map("stock_overrides")
}

model Disclosure {
  rcpNo     String   @id @map("rcp_no")
  code      String
  corpCode  String   @map("corp_code")
  reportNm  String   @map("report_nm")
  pblntfTy  String   @map("pblntf_ty")
  rceptDt   DateTime @map("rcept_dt")
  category  String
  payload   String?
  fetchedAt DateTime @default(now()) @map("fetched_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@index([code, rceptDt])
  @@index([category])
  @@map("disclosures")
}

model StockLink {
  id        String   @id @default(uuid())
  code      String
  url       String
  title     String?
  siteName  String?  @map("site_name")
  imageUrl  String?  @map("image_url")
  kind      String   @default("blog")
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@unique([code, url])
  @@index([code, createdAt])
  @@map("stock_links")
}

model StockRating {
  code      String   @id
  grade     String // "high"=상 | "mid"=중 | "low"=하
  updatedAt DateTime @updatedAt @map("updated_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@index([grade])
  @@map("stock_ratings")
}

model EtfWatch {
  code      String   @id
  isin      String?  @map("isin")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  snapshots EtfPdfSnapshot[]

  @@map("etf_watches")
}

// 관심종목. 토스증권 심볼(KR 6자리 또는 US 티커)을 저장. 현재가·통화는 토스 API로
// 실시간 조회하므로 여기엔 보관하지 않음. StockMaster(KR 전용)에 FK로 묶지 않는다.
model StockWatch {
  symbol        String   @id
  name          String
  market        String? // KOSPI/KOSDAQ/NASDAQ/NYSE 등
  currency      String? // KRW/USD
  purchasePrice Float?   @map("purchase_price") // 사용자 입력 구매가(종목 통화 기준). 미입력 시 null
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  memberships   StockWatchMembership[]

  @@index([sortOrder])
  @@map("stock_watches")
}

model StockWatchGroup {
  id        String @id @default(uuid())
  name      String @unique
  createdAt DateTime @default(now())
  members   StockWatchMembership[]
  @@map("stock_watch_groups")
}

model StockWatchMembership {
  groupId String
  symbol  String
  group   StockWatchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  watch   StockWatch @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  @@id([groupId, symbol])
  @@index([symbol])
  @@map("stock_watch_memberships")
}

model RecentStockView {
  symbol   String @id
  name     String
  market   String?
  currency String?
  viewedAt DateTime @default(now())
  @@index([viewedAt])
  @@map("recent_stock_views")
}

model EtfPdfSnapshot {
  id          String   @id @default(uuid())
  etfCode     String   @map("etf_code")
  trdDd       String   @map("trd_dd")
  marketValue BigInt?  @map("market_value")
  // 기간별 수익률 JSON(EtfReturns: referenceDate·market·nav). Naver etfAnalysis 원값 그대로
  returnsJson String?  @map("returns_json")
  // 분배금 요약 JSON(EtfDividend: perShareTtm·yieldTtm·countThisYear·monthsThisYear)
  dividendJson String? @map("dividend_json")
  fetchedAt   DateTime @default(now()) @map("fetched_at")

  watch    EtfWatch        @relation(fields: [etfCode], references: [code], onDelete: Cascade)
  holdings EtfPdfHolding[]

  @@unique([etfCode, trdDd])
  @@index([etfCode, trdDd])
  @@map("etf_pdf_snapshots")
}

model EtfPdfHolding {
  id              String @id @default(uuid())
  snapshotId      String @map("snapshot_id")
  constituentCode String @map("constituent_code")
  constituentName String @map("constituent_name")
  weight          Float?
  shares          Float?
  amount          Float?

  snapshot EtfPdfSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("etf_pdf_holdings")
}

// KB증권 펀드(단일, VIP한국형가치투자) 추적. ETF와 달리 보유종목은 운용보고서
// 기준이라 드물게 바뀌므로, snapshotFund()가 내용이 바뀔 때만 새 스냅샷을 남긴다.
model FundSnapshot {
  id        String   @id @default(uuid())
  fundCode  String   @map("fund_code") // KB amak_stnd_cd
  trdDd     String   @map("trd_dd") // 생성일 YYYYMMDD (KST)
  nav       Float? // 스냅샷 시점 최신 기준가(참고용)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  holdings FundHolding[]

  @@unique([fundCode, trdDd])
  @@index([fundCode, trdDd])
  @@map("fund_snapshots")
}

model FundHolding {
  id         String @id @default(uuid())
  snapshotId String @map("snapshot_id")
  name       String
  weight     Float? // 비중 %
  rank       Int // 1-based

  snapshot FundSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@map("fund_holdings")
}

model FundNav {
  id       String @id @default(uuid())
  fundCode String @map("fund_code")
  date     String // YYYYMMDD
  nav      Float // 기준가(원)

  @@unique([fundCode, date])
  @@map("fund_navs")
}

// 무한매수법 자동매매 사이클. 평단·보유·수익률은 토스 라이브 조회, 여기엔 설정·회차·주문이력만.
model InfiniteBuyCycle {
  id            String   @id @default(uuid())
  symbol        String // 토스 심볼(US 티커, 예: TQQQ)
  name          String // 표시용 종목명
  accountSeq    Int?     @map("account_seq") // 토스 계좌(null=기본계좌)
  principal     Float // 원금(USD)
  splits        Int      @default(40)
  profitTarget  Float    @default(10) @map("profit_target") // 익절 %
  bigBuyPremium Float    @default(12) @map("big_buy_premium") // 큰수 LOC 프리미엄 %
  lossCut       Float    @default(10) @map("loss_cut") // 소진 후 손절 기준 %
  status        String   @default("active") // active | paused | completed | stopped
  dryRun        Boolean  @default(true) @map("dry_run")
  version       String   @default("v1") // "v1" | "v2.2" 전략 버전
  round         Int      @default(0)
  // ── v4.0 전용 상태 (v1/v2.2에선 null) ──
  tValue        Float?   @map("t_value") // 연속 T (체결 반영으로만 갱신)
  cashRemaining Float?   @map("cash_remaining") // 잔금(USD). 생성 시 principal
  starBase      Float?   @map("star_base") // 별% base = 지정가매도 % (TQQQ 15 / SOXL 20)
  note          String? // 마지막 경고/보류 사유 (대시보드 배지)
  lastRunDate   String?  @map("last_run_date") // 마지막 실행 US 거래일
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  orders InfiniteBuyOrder[]

  @@map("infinite_buy_cycles")
}

model InfiniteBuyOrder {
  id           String   @id @default(uuid())
  cycleId      String   @map("cycle_id")
  tradeDate    String   @map("trade_date") // US 거래일
  round        Int
  side         String // BUY | SELL
  kind         String // v1: first_market|loc_avg|loc_big|target_sell|reset_sell / v2.2: first_market|loc_avg|loc_var|sell_loc_var|sell_lim_10|reset_sell
  orderType    String   @map("order_type") // LIMIT | MARKET
  tif          String // CLS | DAY
  price        Float?
  quantity     Float
  avgCost      Float?   @map("avg_cost") // SELL 시점 평단(실현손익 계산용)
  filledQty    Float?   @map("filled_qty") // 실제 체결 수량(토스 동기화)
  filledPrice  Float?   @map("filled_price") // 평균 체결가(토스 동기화)
  filledAt     String?  @map("filled_at") // 체결 시각(토스, ISO KST)
  tossOrderId  String?  @map("toss_order_id")
  stateApplied Boolean? @map("state_applied") // v4: 이 체결이 T/잔금에 반영됐는지(멱등 마커)
  dryRun       Boolean  @map("dry_run")
  status       String // submitted | filled | failed | simulated | skipped
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  cycle InfiniteBuyCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, tradeDate])
  @@map("infinite_buy_orders")
}

model Week52Price {
  code      String   @id
  high      Float
  low       Float
  asOfDate  DateTime @map("as_of_date")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  master StockMaster @relation(fields: [code], references: [code], onDelete: Cascade)

  @@map("week52_prices")
}

model MarketRate {
  kind      String   @id
  ratePct   Float    @map("rate_pct")
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("market_rates")
}

// 밸류리밸런싱(VR 5.0) 계좌. V·Pool은 체결 반영·사이클 갱신으로만 변경.
// 보유수량은 저장하지 않고 VrOrder 체결(seed 포함) 누적으로 파생한다.
model VrAccount {
  id             String   @id @default(uuid())
  symbol         String // 토스 심볼(US 티커, 예: TQQQ)
  name           String // 표시용 종목명
  accountSeq     Int?     @map("account_seq") // 토스 계좌(null=기본계좌)
  type           String   @default("accumulate") // accumulate(적립) | lumpsum(거치)
  formula        String   @default("skill") // basic | skill (V 갱신 공식)
  gValue         Float    @default(10) @map("g_value") // G 기울기 (수동 조정 가능)
  bandPct        Float    @default(15) @map("band_pct") // 밴드 ±%
  contribution   Float    @default(0) // 사이클(2주)당 적립금 USD (거치식 0)
  poolLimitMode  String   @default("auto") @map("pool_limit_mode") // auto | manual
  poolLimitPct   Float?   @map("pool_limit_pct") // manual일 때 고정 %
  vValue         Float    @map("v_value") // 현재 목표가치 V
  pool           Float // 현재 Pool(USD)
  startDate      String   @map("start_date") // 시작 US 거래일 (주차 앵커)
  cycleIndex     Int      @default(0) @map("cycle_index")
  cycleStartDate String   @map("cycle_start_date") // 현재 사이클 시작 거래일
  status         String   @default("active") // active | paused | stopped
  dryRun         Boolean  @default(true) @map("dry_run")
  note           String? // 마지막 경고/보류 사유 (대시보드 배지)
  lastRunDate    String?  @map("last_run_date") // 마지막 실행 US 거래일 (중복 실행 방지)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders    VrOrder[]
  cycleLogs VrCycleLog[]

  @@map("vr_accounts")
}

model VrOrder {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  cycleIndex   Int      @map("cycle_index")
  tradeDate    String   @map("trade_date") // US 거래일
  side         String // BUY | SELL
  kind         String // seed | loc_buy | limit_sell
  orderType    String   @map("order_type") // LIMIT | MARKET
  tif          String // CLS | DAY
  price        Float?
  quantity     Float
  filledQty    Float?   @map("filled_qty")
  filledPrice  Float?   @map("filled_price")
  filledAt     String?  @map("filled_at")
  tossOrderId  String?  @map("toss_order_id")
  stateApplied Boolean? @map("state_applied") // 이 체결이 Pool에 반영됐는지(멱등 마커)
  dryRun       Boolean  @map("dry_run")
  status       String // simulated | simulated_filled | expired | submitted | filled | failed | skipped
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  account VrAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, tradeDate])
  @@map("vr_orders")
}

// 사이클 경계(V 갱신) 기록. 대시보드 그래프 + 감사 추적용. accountId+cycleIndex 유니크로 멱등 보강.
model VrCycleLog {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  cycleIndex   Int      @map("cycle_index") // 갱신 후 사이클 번호
  date         String // 사이클 시작 US 거래일
  vValue       Float    @map("v_value") // 갱신 후 V
  evalAmount   Float    @map("eval_amount") // 공식에 쓴 E (직전 거래일 종가 × 보유)
  pool         Float // 갱신 시점 Pool (적립 반영 후)
  contribution Float
  gValue       Float    @map("g_value")
  poolLimitPct Float    @map("pool_limit_pct")
  holdingQty   Float    @map("holding_qty")
  createdAt    DateTime @default(now()) @map("created_at")

  account VrAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, cycleIndex])
  @@map("vr_cycle_logs")
}

// QQQ·QLD 적립식: base 종목이 직전 최고가 대비 thresholdPct 이상 하락한 거래일에는
// leverSymbol을, 그 외에는 baseSymbol을 매 거래일 dailyAmountKrw만큼 매수한다.
// 매수는 토스 금액 기반 시장가 주문(orderType=MARKET + orderAmount)이라 소수 수량이 나온다
// (LOC 종가매수는 소수점 매수와 명세상 공존할 수 없어 폐기됐다).
model DcaAccount {
  id              String   @id @default(uuid())
  name            String // 표시용 이름
  baseSymbol      String   @default("QQQ") @map("base_symbol")
  leverSymbol     String   @default("QLD") @map("lever_symbol")
  accountSeq      Int?     @map("account_seq") // 토스 계좌(null=기본계좌)
  thresholdPct    Float    @default(10) @map("threshold_pct") // 이 % 이상 하락 시 레버리지
  dailyAmountKrw  Float    @default(50000) @map("daily_amount_krw") // 거래일당 적립액(원)
  cashKrw         Float    @default(0) @map("cash_krw") // 미체결 이월 잔액(원)
  peakPrice       Float    @map("peak_price") // base 종목 최고 종가
  peakDate        String   @map("peak_date")
  startDate       String   @map("start_date")
  status          String   @default("active") // active | paused | stopped
  dryRun          Boolean  @default(true) @map("dry_run")
  note            String? // 마지막 경고/보류 사유 (대시보드 배지)
  lastRunDate     String?  @map("last_run_date") // 거래일당 1회 실행 보장
  lastAccrualDate String?  @map("last_accrual_date") // 적립 멱등 마커 (lastRunDate와 분리)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders DcaOrder[]

  @@map("dca_accounts")
}

model DcaOrder {
  id            String   @id @default(uuid())
  accountId     String   @map("account_id")
  tradeDate     String   @map("trade_date") // US 거래일
  symbol        String // 실제 매수한 종목 (QQQ | QLD)
  side          String // BUY 고정
  kind          String // loc_buy 고정
  orderType     String   @map("order_type") // MARKET
  tif           String? // 금액 기반 주문에는 없음
  price         Float? // 주문 시점 참조 시세(감사용). 금액 기반 주문에는 지정가가 없다
  quantity      Float? // 주문 시점 예상 수량(감사용). 실제 수량은 체결 시 결정된다
  amountUsd     Float    @map("amount_usd") // 주문한 달러 금액 — 금액 기반 주문의 핵심 값
  clientOrderId String?  @map("client_order_id") // 토스 멱등성 키. dryRun에서는 null
  amountKrw     Float    @map("amount_krw") // 주문 시 배정한 원화(추정)
  fxRate        Float    @map("fx_rate") // 주문 시 USD/KRW — 체결 차감에 재사용
  drawdownPct   Float    @map("drawdown_pct") // 판정에 쓴 낙폭(%) — 감사용
  filledQty     Float?   @map("filled_qty")
  filledPrice   Float?   @map("filled_price")
  filledAt      String?  @map("filled_at")
  tossOrderId   String?  @map("toss_order_id")
  stateApplied  Boolean? @map("state_applied") // cashKrw 반영 여부(멱등 마커)
  dryRun        Boolean  @map("dry_run")
  status        String // simulated_filled | expired | submitting | submitted | filled | rejected | submit_unknown
  //   expired는 금액 기반 dryRun에서는 발생하지 않지만 LIVE 경로에는 남음
  //   submitting: 제출 직전에 만든 뮤텍스 행 / submit_unknown: 제출 결과 미확인(수동 확인 필요)
  //   rejected: 브로커가 HTTP 400/422로 확실히 거절 — 주문 미생성, 잔액 영향 없음(확인 불필요)
  error         String?
  createdAt     DateTime @default(now()) @map("created_at")

  account DcaAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, tradeDate])
  @@map("dca_orders")
}

// 독립 차수 장부. 실계좌·실주문과 연결하지 않는 정수주 모의 실행 전용.
model SplitSimulation {
  id             String   @id @default(uuid())
  symbol         String
  name           String
  market         String // KR | US
  source         String // manual | toss (가격 원천 혼합 금지)
  initialCash    Float    @map("initial_cash")
  cash           Float
  trancheBudget  Float    @map("tranche_budget")
  maxTranches    Int      @map("max_tranches")
  buyDropPct     Float    @map("buy_drop_pct")
  takeProfitPct  Float    @map("take_profit_pct")
  feePct         Float    @default(0) @map("fee_pct")
  sellTaxPct     Float    @default(0) @map("sell_tax_pct")
  dryRun         Boolean  @default(true) @map("dry_run")
  status         String   @default("active") // active | paused | completed
  revision       Int      @default(0)
  stepCount      Int      @default(0) @map("step_count")
  lastPrice      Float?   @map("last_price")
  lastObservedAt DateTime? @map("last_observed_at")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  lots SplitLot[]
  runs SplitRun[]

  @@map("split_simulations")
}

model SplitLot {
  id           String   @id @default(uuid())
  simulationId String   @map("simulation_id")
  slot         Int
  generation   Int
  anchorPrice  Float    @map("anchor_price")
  buyPrice     Float    @map("buy_price")
  quantity     Int
  remainingQty Int      @map("remaining_qty")
  buyCost      Float    @map("buy_cost")
  buyFee       Float    @map("buy_fee")
  sellPrice    Float?   @map("sell_price")
  sellFee      Float    @default(0) @map("sell_fee")
  sellTax      Float    @default(0) @map("sell_tax")
  realizedPnl  Float    @default(0) @map("realized_pnl")
  openedStep   Int      @map("opened_step")
  closedStep   Int?     @map("closed_step")

  simulation SplitSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, slot, generation])
  @@map("split_lots")
}

model SplitRun {
  id           String   @id @default(uuid())
  simulationId String   @map("simulation_id")
  requestKey   String   @map("request_key")
  source       String
  inputJson    String   @map("input_json")
  fillCount    Int      @map("fill_count")
  observedAt   DateTime @map("observed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  simulation SplitSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@unique([simulationId, requestKey])
  @@index([simulationId, createdAt])
  @@map("split_runs")
}

// 실거래 장부는 모의 장부와 분리한다. 금액은 원화/달러 원통화 기준.
model SplitLiveStrategy {
  id String @id @default(uuid())
  accountSeq Int
  symbol String
  name String
  market String
  initialCash Float
  cash Float
  trancheBudget Float
  budgetMode String @default("fixed")
  budgetMultiplier Float @default(1)
  maxTranches Int
  buyDropPct Float
  takeProfitPct Float
  firstTakeProfitPct Float @default(10)
  trancheSettingsJson String?
  // NULL waits for the previous cycle's executed slot-1 buy price.
  reentryDropPct Float?
  feeBufferPct Float @default(1)
  status String @default("paused")
  note String?
  revision Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  lastCheckedAt DateTime?
  lastPrice Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lots SplitLiveLot[]
  orders SplitLiveOrder[]
  reservation SplitBuyReservation?
  @@map("split_live_strategies")
}

model SplitBuyReservation {
  strategyId String @id
  watchPrice Float
  expiresAt DateTime
  status String @default("waiting")
  orderId String?
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  strategy SplitLiveStrategy @relation(fields: [strategyId], references: [id])
  events SplitReservationEvent[]
  @@index([status, expiresAt])
  @@map("split_buy_reservations")
}

model SplitReservationEvent {
  id String @id @default(uuid())
  strategyId String
  type String
  message String
  watchPrice Float
  expiresAt DateTime
  orderId String?
  createdAt DateTime @default(now())
  reservation SplitBuyReservation @relation(fields: [strategyId], references: [strategyId])
  @@index([strategyId, createdAt])
  @@map("split_reservation_events")
}

model SplitLiveLot {
  id String @id @default(uuid())
  strategyId String
  slot Int
  generation Int
  boughtQty Int @default(0)
  boughtAmount Float @default(0)
  buyFees Float @default(0)
  buyTax Float @default(0)
  soldQty Int @default(0)
  soldAmount Float @default(0)
  sellFees Float @default(0)
  sellTax Float @default(0)
  strategy SplitLiveStrategy @relation(fields: [strategyId], references: [id])
  orders SplitLiveOrder[]
  @@unique([strategyId, slot, generation])
  @@map("split_live_lots")
}

model SplitLiveOrder {
  id String @id @default(uuid())
  strategyId String
  lotId String
  sequence Int
  clientOrderId String @unique
  tossOrderId String? @unique
  side String
  quantity Int
  price Float
  status String @default("submitting")
  brokerStatus String?
  lastSellFillPrice Float?
  reentryTarget Float?
  lastSyncedAt DateTime?
  filledQty Int @default(0)
  filledAmount Float @default(0)
  commission Float @default(0)
  tax Float @default(0)
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  strategy SplitLiveStrategy @relation(fields: [strategyId], references: [id])
  lot SplitLiveLot @relation(fields: [lotId], references: [id])
  @@unique([strategyId, sequence])
  @@index([strategyId, status])
  @@map("split_live_orders")
}

// 소유권은 일시정지 중에도 유지한다. 전량 청산한 전략만 반납할 수 있다.
model SplitSymbolOwner {
  accountSeq Int
  symbol String
  strategyId String @unique
  @@id([accountSeq, symbol])
  @@map("split_symbol_owners")
}
